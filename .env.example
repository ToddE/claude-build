# inform9 environment template. Copy to .env.local and fill in. Never commit .env.local.
# For local Worker runs (wrangler dev), copy the same values to .dev.vars.
# In production, set secrets with: wrangler secret put NAME   (see planning/credentials-checklist)
# Values marked SECRET must never appear in logs, the repository, or the browser.
# After the first release, the Settings screens can override the non-secret values and store keys encrypted.

# ---------- Site ----------
APP_BASE_URL=http://localhost:4321
ASSET_BASE_URL=http://localhost:4321/email
ENVIRONMENT=development

# ---------- Cloudflare (needed to deploy, not to run locally) ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=            # SECRET. Scopes: Workers, D1, R2, Pages, DNS edit for inform9.com
D1_DATABASE_NAME=inform9
D1_DATABASE_ID=
R2_BUCKET_NAME=inform9-w9
R2_BACKUP_BUCKET_NAME=inform9-backups

# ---------- Encryption (taxpayer IDs, PDFs, stored provider keys) ----------
MASTER_KEY=                      # SECRET. 32 random bytes, base64. Generate: openssl rand -base64 32
MASTER_KEY_ID=k1                 # Label stored beside each encrypted value. Change when rotating.
PREVIOUS_MASTER_KEYS=            # SECRET. Optional JSON, for example {"k0":"base64..."}, so old data stays readable

# ---------- Email (SMTP2GO for the prototype) ----------
EMAIL_PROVIDER=smtp2go
SMTP2GO_API_KEY=                 # SECRET
SMTP2GO_WEBHOOK_SECRET=          # SECRET. Random string. Put it in the webhook URL or header you give SMTP2GO
EMAIL_FROM_NAME=inform9
EMAIL_FROM_ADDRESS=no-reply@mail.inform9.com
SUPPORT_EMAIL=support@inform9.com
POSTAL_ADDRESS=                  # Required in marketing email. Optional for account notices

# ---------- Payments (Stripe) ----------
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=               # SECRET. Use a test key until launch
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=           # SECRET
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# ---------- Bot protection (Cloudflare Turnstile) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=            # SECRET

# ---------- Analytics (Umami, no cookies, public pages only) ----------
UMAMI_ENABLED=false
UMAMI_SCRIPT_URL=
UMAMI_SITE_ID=

# ---------- Sign in with Google (deferred, leave off) ----------
GOOGLE_SIGNIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=            # SECRET

# ---------- First administrator ----------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=        # SECRET. Used once by the seed script, then remove it

# ---------- Setting overrides (optional, see planning/data-model, section 4) ----------
# Any settings key can be set as SETTING_<KEY> with dots as double underscores, for example:
# SETTING_share__link_days=7
# SETTING_share__daily_download_cap=5
